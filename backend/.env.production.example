APP_NAME=MedDevice Backend
ENVIRONMENT=production

# Use a managed/private PostgreSQL URL in production. Do not commit the real password.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@DB_HOST:5432/meddevice

# Generate a long random value, e.g. Python secrets.token_urlsafe(64).
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_EXPIRE_MINUTES=480

# Exact Vercel production origin. Add multiple origins separated by commas if required.
CORS_ORIGINS=https://YOUR-PROJECT.vercel.app

# Admin bootstrap values. Change the password before first deployment.
ADMIN_EMAIL=admin@hospital.example
ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_ADMIN_PASSWORD
ADMIN_FULL_NAME=System Administrator

# In production this path must be persistent/shared if Spark runs on another host.
ANALYTICS_DIR=/app/analytics/generated
